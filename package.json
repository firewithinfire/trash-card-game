{
  "name": "trash-card-game",
  "version": "1.0.0",
  "private": true,
  "description": "Online multiplayer 'Trash' card game (a Shithead/Palace variant)",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/make-icons.mjs && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/simulate.ts",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "vite": "^5.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "playwright-core": "^1.49.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
